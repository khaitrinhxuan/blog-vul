# Local configuration template for blog-vul.
#
# Copy this file and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored (see .gitignore). NEVER commit real credentials or key
# material: the previous revision tracked `.env` together with the RSA JWT key
# pair, which disclosed the Django SECRET_KEY, the database password and the JWT
# signing key to anyone holding the repository or an image built from it.
#
# Secret values below are deliberately empty. Generate the key pair with
# `python script/generate_keys.py` instead of committing it.

POSTGRES_USER=blogapp
# Secret: pick a strong value.
POSTGRES_PASSWORD=
POSTGRES_DB=blogapp

DEBUG=False

# Secret: generate one, e.g. `python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"`.
SECRET_KEY=

SERVER=http://localhost:8000

DATABASE_NAME=blogapp
DATABASE_USER=blogapp
# Secret: pick a strong value.
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_ENGINE=django.db.backends.postgresql

ALLOWED_HOSTS=localhost,127.0.0.1

XSS=False
CSRF=False

# Paths to the locally generated key pair. Files are not committed; create them with
# `python script/generate_keys.py` (run automatically by script/entrypoint.sh).
PRIVATEKEY=blogapp/key/priv.pem
PUBLICKEY=blogapp/key/pub.key

avatarLink=core/media/uploads
